{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/approval-record.schema.json",
  "title": "Human approval bound to one outbound message",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "draft_id",
    "permission",
    "approver",
    "decision",
    "from",
    "to",
    "cc",
    "bcc",
    "reply_to",
    "subject",
    "template_id",
    "template_version",
    "payload_sha256",
    "single_use",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "approval_id": {"type": "string", "pattern": "^approval_[a-z0-9_]{8,80}$"},
    "draft_id": {"type": "string", "minLength": 1},
    "permission": {"type": "string", "const": "send"},
    "approver": {"type": "string", "const": "person"},
    "decision": {"type": "string", "enum": ["approved", "rejected"]},
    "from": {"type": "string"},
    "to": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string"}},
    "cc": {"type": "array", "items": {"type": "string"}},
    "bcc": {"type": "array", "items": {"type": "string"}},
    "reply_to": {"type": "array", "items": {"type": "string"}},
    "subject": {"type": "string", "minLength": 1},
    "template_id": {"type": "string", "minLength": 1},
    "template_version": {"type": "string", "minLength": 1},
    "payload_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "single_use": {"type": "boolean", "const": true},
    "recorded_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
