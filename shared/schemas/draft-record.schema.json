{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/draft-record.schema.json",
  "title": "Draft record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "draft_id", "idempotency_key", "permission", "role", "from", "to", "subject", "threading", "template_id", "text", "html", "asset_urls"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "draft_id": {"type": "string"},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9._-]{8,200}$"},
    "permission": {"type": "string", "const": "draft"},
    "role": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "from": {"type": "string"},
    "to": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string"}},
    "subject": {"type": "string"},
    "threading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in_reply_to", "references"],
      "properties": {
        "in_reply_to": {"type": "string"},
        "references": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "template_id": {"type": "string"},
    "text": {"type": "string", "minLength": 1},
    "html": {"type": "string", "minLength": 1},
    "asset_urls": {"type": "array", "items": {"type": "string"}}
  }
}
