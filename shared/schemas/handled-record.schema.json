{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/handled-record.schema.json",
  "title": "Immutable handled key",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "idempotency_key", "object_bucket", "object_key", "role", "first_seen_at", "immutable"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9._-]{8,200}$"},
    "object_bucket": {"type": "string", "minLength": 3},
    "object_key": {"type": "string", "pattern": "^raw/[A-Za-z0-9._-]+$"},
    "role": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "first_seen_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "immutable": {"type": "boolean", "const": true}
  }
}
